{
  "description": "Local source-side filtering. Original input never reaches Qiuqiu.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "FinalStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEBUDDY_PLUGIN_ROOT}/scripts/emit-metadata.sh\"",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
